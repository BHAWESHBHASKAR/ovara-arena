{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ovara-grid",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": {
    "bindings": [
      { "name": "SESSION", "class_name": "OvaraSession" },
      { "name": "QUOTA", "class_name": "Quota" }
    ]
  },
  "exports": {
    "OvaraSession": { "type": "durable-object", "storage": "sqlite" },
    "Quota": { "type": "durable-object", "storage": "sqlite" }
  },
  "containers": [
    {
      "class_name": "OvaraSession",
      "scheduling_policy": "durable_object",
      "images": { "sandbox": { "image": "registry.cloudflare.com/3541b3dffc96eaef632727ffc59c7e91/ovara-grid-ovarasession-sandbox@sha256:e44217d45b30417f6c586e9f702c75277bd3ff74ee1e3117c030da0f29a0a82c" } }
    }
  ],
  "vars": {
    "LLM_PROVIDER": "nebius",
    "MAX_CONCURRENT": "10",
    "SESSIONS_PER_DAY": "60",
    "SPEND_CAP_USD": "0.25",
    "DEMO_DISABLED": "0"
  },
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true } }
}
